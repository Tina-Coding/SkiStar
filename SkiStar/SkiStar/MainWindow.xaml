<Window x:Class="SkiStar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SkiStar"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Name="btnRegisterskier" Content="Registrera ny skidåkare" HorizontalAlignment="Left" Margin="118,264,0,0" VerticalAlignment="Top" Click="btn_register_skier" RenderTransformOrigin="0.5,0.5" Height="27" Width="134">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.078"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <TextBox Name="txtfirstname" HorizontalAlignment="Left" Margin="118,110,0,0" TextWrapping="Wrap" Text="{}" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="118,89,0,0" TextWrapping="Wrap" Text="Förnamn" VerticalAlignment="Top"/>
        <TextBox Name="txtlastname" HorizontalAlignment="Left" Margin="118,164,0,0" TextWrapping="Wrap" Text="{}" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.417,0.392"/>
        <TextBlock HorizontalAlignment="Left" Margin="118,143,0,0" TextWrapping="Wrap" Text="Efternamn" VerticalAlignment="Top"/>
        <TextBox Name="txtemail" HorizontalAlignment="Left" Margin="118,217,0,0" TextWrapping="Wrap" Text="{}" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="118,196,0,0" TextWrapping="Wrap" Text="Email" VerticalAlignment="Top" RenderTransformOrigin="0.515,3.825"/>
        <Button Name ="btnsearchskier" Content="Sök skidåkare" HorizontalAlignment="Left" Margin="120,311,0,0" VerticalAlignment="Top" Height="28" Width="132" Click="btn_search_skier"/>

    </Grid>
</Window>
