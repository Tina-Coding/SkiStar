<Window x:Class="SkiDataSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SkiDataSimulator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height= "Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" Grid.Row="1">
            <Button x:Name="btnSimulateSeason" Content="Simulera säsong" Width="150" Margin="5" Click="btn_Simulate_Season"/>
            <Button x:Name="btnSimulateDay" Content="Simulera dag" Width="150" Margin="5" Click="btn_Simulate_Day"/>
            <TextBlock HorizontalAlignment="Left" Margin="5" TextWrapping="Wrap" Text="Förnamn" VerticalAlignment="Top" Height="16" Width="60"/>
            <TextBox Name="txtfirstname" HorizontalAlignment="Left" Margin="5" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="18"/>
            <TextBlock HorizontalAlignment="Left" Margin="5" TextWrapping="Wrap" Text="Efternamn" VerticalAlignment="Top" Height="16" Width="60"/>
            <TextBox Name="txtlastname" HorizontalAlignment="Left" Margin="5" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="18"/>
            <Button Name ="btnsearchskier" Content="Sök skidåkare" HorizontalAlignment="Left" Margin="5" VerticalAlignment="Top" Height="28" Width="132" Click="btn_Search_Skier"/>
            <Button Name="btnRegisterskier" Content="Registrera ny skidåkare" HorizontalAlignment="Left" Margin="5" VerticalAlignment="Top" Height="27" Width="134" Click="btn_Register_New_Skier"/>
            <Button x:Name="btnDeleteSkier" Content="Radera skidåkare" HorizontalAlignment="Left" Margin="5" VerticalAlignment="Top"  Height="27" Width="134" Click="btn_Delete_Skier"/>

        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="2">

        </StackPanel>

        <StackPanel Grid.Column="3" Grid.Row="1">

            <TextBlock HorizontalAlignment="Left" Margin="5" TextWrapping="Wrap" Text="Destination" VerticalAlignment="Top"/>
            <ComboBox Name="CbDestination" HorizontalAlignment="Left" Margin="5" VerticalAlignment="Top" Width="134" Height="24" SelectionChanged="cbDestination_SelectionChanged"/>
            <TextBlock HorizontalAlignment="Left" Margin="5" TextWrapping="Wrap" Text="Anläggning" VerticalAlignment="Top"/>
            <ComboBox Name="CbResort" HorizontalAlignment="Left" Margin="5" VerticalAlignment="Top" Width="134" Height="24" SelectionChanged="cbResort_SelectionChanged"/>
            <TextBlock HorizontalAlignment="Left" Margin="5" TextWrapping="Wrap" Text="Liftar" VerticalAlignment="Top"/>
            <ComboBox Name="CbLift" HorizontalAlignment="Left" Margin="5" VerticalAlignment="Top" Width="134" Height="24"/>
            <TextBox Name="txtCardNumber" HorizontalAlignment="Left" Margin="5" TextWrapping="Wrap" Text="Kortnummer" VerticalAlignment="Top" Width="148" Height="18"/>
            <TextBox Name="txtStartdate" HorizontalAlignment="Left" Margin="5" TextWrapping="Wrap" Text="Startdatum" VerticalAlignment="Top" Width="148" Height="18"/>
            <TextBox Name="txtEnddate" HorizontalAlignment="Left" Margin="5" TextWrapping="Wrap" Text="Slutdatum" VerticalAlignment="Top" Width="148" Height="18"/>
            <TextBox Name="txtTodaysdate" HorizontalAlignment="Left" Margin="5" TextWrapping="Wrap" Text="Dagens datum" VerticalAlignment="Top" Width="148" Height="18"/>
            <Button Name="BtnRegisterSkiRun" Content="Registrera åk" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top" Height="27" Width="134" Click="btn_Register_Skirun"/>
            <Button Name="BtnBuyskipass" Content="Köp liftkort" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top" Height="27" Width="134" Click="btn_Buy_Skipass"/>
            

        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="1">
            <ComboBox Name="CbSkiers" HorizontalAlignment="Left" Margin="5" VerticalAlignment="Top" Width="134" Height="24"/>
            <TextBlock Name="txtMoreInfo" HorizontalAlignment="Left" Margin="5" TextWrapping="Wrap" Text="Mer information" VerticalAlignment="Top"/>
            <Button x:Name="btnGetMoreInfo" Content="Hämta mer information" HorizontalAlignment="Left" Margin="5" VerticalAlignment="Top"  Height="27" Width="134" Click="btn_Get_More_Info"/>
            <Label Name ="txtaddedskier" Content="" HorizontalAlignment="Left" Margin="5,100,5,5" VerticalAlignment="Top" Height="100" Width="250" Grid.Column="1" FontSize="20"/>

        </StackPanel>





    </Grid>
</Window>
